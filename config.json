{
  "$schema":"https://sing-box.sagernet.org/schema.json",
  "route":{
    "final":"proxy",
    "default_domain_resolver":"direct",
    "default_http_client":"direct",
    // "auto_detect_interface":true,
    "rules":[
      {"port":53,"action":"hijack-dns"},
      {"port":123,"network":"udp","action":"bypass"},
      {"ip_is_private":true,"action":"bypass"},

      {"action":"sniff"},
      {"protocol":"dns","action":"hijack-dns"},
      {"protocol":"ntp","outbound":"direct"},
      {"rule_set":["geosite-private","rule-process-geph","rule-process-vpn"],"outbound":"direct"},

      // ------- ad -------
      {"rule_set":["geosite-category-httpdns-cn","geosite-category-ads-all","geosite-geolocation-!cn@ads","geosite-cn@ads","rule-custom-block"],"action":"reject"},

      // ------- specific service -------
      {"domain":"raw.githubusercontent.com","outbound":"github-raw"},
      {"domain":"release-assets.githubusercontent.com","outbound":"github-releases"},
      {"domain":"dl.google.com","outbound":"google-dl"},
      {"domain_suffix":["recaptcha.net","recaptcha-cn.net"],"domain":"challenges.cloudflare.com","rule_set":["geosite-hcaptcha"],"outbound":"captcha"},
      {"domain_suffix":"wahlap.com","outbound":"wahlap"},

      {"rule_set":"geoip-as199524","port":[27001,27002],"network":"udp","outbound":"vrchat-photonengine"},
      {"domain":["api.vrchat.cloud","files.vrchat.cloud","file-variants.vrchat.cloud","pipeline.vrchat.cloud","15308.kstore.space"],"rule_set":"rule-vrchat-video-parse","outbound":"direct"},
      {"domain_suffix":"vrchat.com","domain":"svipsvip.ffzy-online5.com","outbound":"proxy"},

      {"domain":["services.gradle.org","repo.maven.apache.org","steamdb.info"],"rule_set":["geosite-googlefcm","rule-googlefcm","geosite-connectivity-check","rule-steam-download"],"outbound":"direct"},
      {"domain":"news.ycombinator.com","outbound":"proxy"},

      // ------- country rule -------
      {"rule_set":["geosite-cn","geosite-geolocation-!cn@cn"],"outbound":"direct"},
      // {"rule_set":["geosite-geolocation-!cn","geosite-gfw"],"outbound":"proxy"},

      // ------- unknown -------
      {"action":"resolve"},
      // {"action":"resolve"},
      {"type":"logical","mode":"and","rules":[
        {"rule_set":"geosite-geolocation-!cn","invert":true},
        {"rule_set":"geoip-cn"}
      ],"outbound":"direct"},
      // {"rule_set":"geoip-cn","outbound":"direct"},

      {"outbound":"proxy"}
    ],
    "rule_set":[
      {"tag":"rule-steam-download","rules":[{"domain":"steamcdn-a.akamaihd.net","domain_suffix":["cm.steampowered.com","steamserver.net"]}]},
      {"tag":"rule-vrchat-video-parse","rules":[{"domain":["kft.vrchat.org.cn","bil.ouo.chat","biliplayer.91vrchat.com","bilibili-real-url.deno.dev"]}]},
      {"tag":"rule-googlefcm","rules":[{"domain_suffix":["mobile-gtalk6.l.google.com","mobile-gtalk4.l.google.com","mobile-gtalk.l.google.com"]}]},
      {"tag":"rule-geph-broker","rules":[{"domain":["lambda.us-east-1.amazonaws.com","kubernetes.io","www.cdn77.com"]}]},
      {"tag":"rule-process-geph","rules":[{"process_name":["geph5-client.exe","geph5.exe"]}]},
      {"tag":"rule-process-vpn","rules":[{"process_name":["tailscaled.exe","cloudflared.exe"]}]},

      {"tag":"geosite-geolocation-!cn@ads","url":"https://raw.githubusercontent.com/nekolsd/sing-geosite/rule-set/geolocation-!cn@ads.srs","http_client":"ruleset","type":"remote"},
      {"tag":"geosite-cn@ads","url":"https://raw.githubusercontent.com/nekolsd/sing-geosite/rule-set/cn@ads.srs","http_client":"ruleset","type":"remote"},
      {"tag":"geosite-category-httpdns-cn","url":"https://raw.githubusercontent.com/nekolsd/sing-geosite/rule-set/category-httpdns-cn.srs","http_client":"ruleset","type":"remote"},
      {"tag":"geosite-category-ads-all","url":"https://raw.githubusercontent.com/nekolsd/sing-geosite/rule-set/category-ads-all.srs","http_client":"ruleset","type":"remote"},
      {"tag":"geosite-hcaptcha","url":"https://raw.githubusercontent.com/nekolsd/sing-geosite/rule-set/hcaptcha.srs","http_client":"ruleset","type":"remote"},
      {"tag":"geosite-googlefcm","url":"https://raw.githubusercontent.com/nekolsd/sing-geosite/rule-set/googlefcm.srs","http_client":"ruleset","type":"remote"},
      {"tag":"geosite-connectivity-check","url":"https://raw.githubusercontent.com/nekolsd/sing-geosite/rule-set/connectivity-check.srs","http_client":"ruleset","type":"remote"},
      {"tag":"geosite-geolocation-!cn","url":"https://raw.githubusercontent.com/nekolsd/sing-geosite/rule-set/geolocation-!cn.srs","http_client":"ruleset","type":"remote"},
      {"tag":"geosite-gfw","url":"https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/gfw.srs","http_client":"ruleset","type":"remote"},
      {"tag":"geosite-geolocation-!cn@cn","url":"https://raw.githubusercontent.com/nekolsd/sing-geosite/rule-set/geolocation-!cn@cn.srs","http_client":"ruleset","type":"remote"},
      {"tag":"geosite-cn","url":"https://raw.githubusercontent.com/nekolsd/sing-geosite/rule-set/cn.srs","http_client":"ruleset","type":"remote"},
      {"tag":"geosite-private","url":"https://raw.githubusercontent.com/nekolsd/sing-geosite/rule-set/private.srs","http_client":"ruleset","type":"remote"},

      // {"tag":"geoip-as32590","url":"https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/asn/AS32590.srs","http_client":"ruleset","type":"remote"},
      {"tag":"geoip-as199524","url":"https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/asn/AS199524.srs","http_client":"ruleset","type":"remote"},
      // {"tag":"geoip-telegram","url":"https://raw.githubusercontent.com/nekolsd/geoip/release/srs/telegram.srs","http_client":"ruleset","type":"remote"},
      {"tag":"geoip-cn","url":"https://raw.githubusercontent.com/nekolsd/geoip/release/srs/cn.srs","http_client":"ruleset","type":"remote"},

      {"tag":"rule-custom-block","rules":[{"domain":["2fa.qwq2333.top","api.qwq2333.top"]}]}
    ]
  },
  "dns":{
    "final":"proxy",
    // "strategy":"ipv4_only",
    "reverse_mapping":true,
    "rules":[
      {"domain":"localhost","server":"localhost"},
      {"preferred_by":"hosts","server":"hosts"},
      {"rule_set":"geosite-private","server":"local"},
      {"rule_set":["rule-geph-broker","rule-process-geph","rule-process-vpn"],"server":"direct"},

      // ------- ad -------
      {"rule_set":["geosite-category-httpdns-cn","geosite-category-ads-all","geosite-geolocation-!cn@ads","geosite-cn@ads","rule-custom-block"],"action":"reject"},

      // ------- specific service -------
      {"domain":"dl.google.com","server":"google-dl"},

      {"domain":"wahlap.com","rule_set":["geosite-googlefcm","rule-googlefcm","rule-steam-download","geosite-connectivity-check"],"server":"direct"},
      {"domain":"news.ycombinator.com","query_type":"A","server":"proxy"},
      {"domain":"news.ycombinator.com","query_type":"AAAA","action":"reject"},

      // ------- country rule -------
      {"rule_set":["geosite-geolocation-!cn@cn","geosite-cn"],"server":"direct"},
      {"rule_set":["geosite-geolocation-!cn","geosite-gfw"],"query_type":"A","server":"proxy"},
      {"rule_set":["geosite-geolocation-!cn","geosite-gfw"],"query_type":"AAAA","action":"reject"},

      // ------- fakeip -------
      // {"query_type":["AAAA","A"],"server":"fakeip"},

      // ------- unknown -------
      {"action":"evaluate","server":"local"},
      {"rule_set":"geoip-cn","match_response":true,"action":"respond"},
      // {"action":"evaluate","server":"proxy"},
      // {"rule_set":"geoip-cn","match_response":true,"server":"local"},

      // ------- final -------
      {"query_type":"A","action":"respond"},
      {"query_type":"AAAA","action":"reject"}
      // {"query_type":"AAAA","rcode":"NOERROR","action":"predefined"}
    ],
    "servers":[
      {"tag":"proxy","detour":"proxy","server":"dns.cloudflare.com","domain_resolver":"hosts","type":"https"},
      // {"tag":"subnet","detour":"proxy","server":"dns.google","domain_resolver":"hosts","type":"https"},
      {"tag":"google-dl","detour":"google-dl","server":"dns.alidns.com","domain_resolver":"hosts","type":"h3"},
      {"tag":"direct","server":"dns.alidns.com","domain_resolver":"hosts","type":"h3"},
      {"tag":"local","type":"local"},
      // {"tag":"dhcp","type":"dhcp"},
      // {"tag":"fakeip","inet4_range":"198.18.0.0/15","inet6_range":"fc00::/18","type":"fakeip"},
      // {"tag":"resolved","type":"resolved","service":"resolved","accept_default_resolvers":false},
      // {"tag":"tailscale","type":"tailscale","endpoint":"tailscale","accept_default_resolvers":false},
      {"tag":"localhost","predefined":{"localhost":["127.0.0.1","::"]},"type":"hosts"},
      {"tag":"vrchat","predefined":{"api.vrchat.cloud":["104.18.26.36","104.18.27.36","2606:4700::6812:1a24","2606:4700::6812:1b24"]},"type":"hosts"},
      {"tag":"hosts","predefined":{"time.cloudflare.com":["162.159.200.123","162.159.200.1"],"dns.pub":["1.12.12.21","120.53.53.53"],"dns.alidns.com":["223.6.6.6","223.5.5.5"],"dns.google":["8.8.4.4", "8.8.8.8"],"dns.cloudflare.com":["104.16.133.229","104.16.132.229"],"cloudflare-dns.com":["104.16.248.249","104.16.249.249"],"raw.githubusercontent.com":["185.199.111.133","185.199.110.133","185.199.109.133","185.199.108.133"],"release-assets.githubusercontent.com":["185.199.111.133","185.199.110.133","185.199.109.133","185.199.108.133"]},"type":"hosts"}
    ]
  },
  "outbounds":[
    {"tag":"proxy","outbounds":["http-9910","socks-9909"],"type":"selector"},
    {"tag":"github-raw","outbounds":["proxy","direct"],"type":"selector"},
    {"tag":"github-releases","outbounds":["proxy","direct"],"type":"selector"},
    {"tag":"captcha","outbounds":["proxy","direct"],"type":"selector"},
    {"tag":"vrchat-photonengine","outbounds":["direct","proxy"],"type":"selector"},
    {"tag":"vrchat-cloud-api","outbounds":["direct","proxy"],"type":"selector"},
    {"tag":"vrchat-cloud-file","outbounds":["direct","proxy"],"type":"selector"},
    {"tag":"vrchat-cloud-pipeline","outbounds":["direct","proxy"],"type":"selector"},
    {"tag":"google-dl","outbounds":["direct","proxy"],"type":"selector"},
    {"tag":"wahlap","outbounds":["direct","lxns"],"type":"selector"},
    {"tag":"lxns","server_port":8080,"server":"proxy.maimai.lxns.net","type":"http"},
    {"tag":"http-9910","server_port":9910,"server":"localhost","domain_resolver":"localhost","type":"http"},
    {"tag":"socks-9909","server_port":9909,"server":"localhost","domain_resolver":"localhost","type":"socks"},
    {"tag":"direct","outbounds":["direct-default","direct-perfer-ipv6","direct-perfer-ipv4","direct-ipv6-only","direct-ipv4-only"],"type":"selector"},
    {"tag":"direct-ipv6-only","domain_resolver":{"strategy":"ipv6_only","server":"local"},"type":"direct"},
    {"tag":"direct-ipv4-only","domain_resolver":{"strategy":"ipv4_only","server":"local"},"type":"direct"},
    {"tag":"direct-perfer-ipv6","domain_resolver":{"strategy":"prefer_ipv6","server":"local"},"type":"direct"},
    {"tag":"direct-perfer-ipv4","domain_resolver":{"strategy":"prefer_ipv4","server":"local"},"type":"direct"},
    {"tag":"direct-default","type":"direct"}
  ],
  "inbounds":[
    // {
    //   "tag":"tun",
    //   "address":[
    //     "fdfe:dcba:9876::1/126",
    //     "172.18.0.1/30"
    //   ],
    //   // "dns_mode":"native",
    //   // "dns_address":[
    //   //   "fdfe:dcba:9876::2",
    //   //   "172.18.0.2"
    //   // ],
    //   "auto_route":true,
    //   // "strict_route":true,
    //   // "auto_redirect":true,
    //   // "include_uid":1000,
    //   // "exclude_uid":0,
    //   // "interface_name":"wlan1",
    //   // "exclude_mptcp":true,
    //   // "loopback_address":"10.7.0.1",
    //   // "route_exclude_address_set":["geoip-cn"],
    //   "platform":{"http_proxy":{"server":"127.0.0.1","server_port":7890,"enabled":true}},
    //   "type":"tun"
    // },
    // {"tag":"tproxy","type":"tproxy","listen":"::","listen_port":7893},
    // {"tag":"redirect","type":"redirect","listen":"::","listen_port":7892},
    // {"tag":"dns","type":"socks","listen":"0.0.0.0","listen_port":7891},
    {"tag":"mixed","type":"mixed","listen":"::","listen_port":7890}
  ],
  "endpoints":[
    // {"tag":"tailscale","type":"tailscale"}
  ],
  "http_clients":[
    {"tag":"proxy","detour":"proxy"},
    {"tag":"ruleset","domain_resolver":"hosts","detour":"proxy"},
    {"tag":"direct"}
  ],
  "services":[
    // {"tag":"usbip-server","provider":"dynamic","type":"usbip-server"},
    // {"tag":"resolved","type":"resolved"},
    {"tag":"api","secret":"thisIsPassword@","listen":"::","listen_port":9090,"type":"api"}
  ],
  // "ntp":{
  //   "enabled":true,
  //   // "domain_resolver":"hosts",
  //   // "server":"time.cloudflare.com",
  //   "server":"time.apple.com",
  //   "server_port":123
  // },
  "log":{
    "timestamp":false,
    "level":"info"
  },
  "experimental":{
    "clash_api":{"secret":"thisIsPassword@","external_controller":"[::]:9091"},
    "cache_file":{"path":"cache.db","store_fakeip":false,"store_dns":false,"enabled":true}
  }
}
